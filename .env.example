# Neon Postgres (로컬 개발 시 localhost URL이면 node-postgres 드라이버 사용)
DATABASE_URL=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# 면접 AI 평가(Responses API, JSON 스키마 출력)에 쓰는 모델
OPENAI_EVAL_MODEL=gpt-4.1-mini
# Vercel Blob — 비공개(Private) 스토어의 토큰. 녹음은 비공개로 올라간다.
BLOB_READ_WRITE_TOKEN=
# 로그인 쿠키 서명과 사용자 OpenAI 키 암호화 (32자 이상 임의 문자열). 바꾸면 모두 다시 로그인하고 키를 다시 등록해야 한다.
# OpenAI API 키·질문 API 토큰은 환경변수가 아니라 각 사용자가 설정 화면에서 등록한다.
SESSION_SECRET=

# 서버 쪽 비용 상한 cron 인증 (Vercel Cron이 Bearer로 보냄)
CRON_SECRET=
