# Neon Postgres (로컬 개발 시 localhost URL이면 node-postgres 드라이버 사용)
DATABASE_URL=
# (선택) OpenAI API 키는 설정 > OpenAI API 키에서 등록한다. 여기 값은 등록된 키가 없을 때만 쓴다.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Vercel Blob
BLOB_READ_WRITE_TOKEN=
# (선택) 고정 질문 API 키. 보통은 설정 > API 토큰에서 발급한 토큰을 쓴다.
QUESTIONS_API_KEY=
# 웹 로그인 비밀번호
APP_PASSWORD=
# 로그인 쿠키 서명 (32자 이상 임의 문자열)
SESSION_SECRET=

# 서버 쪽 비용 상한 cron 인증 (Vercel Cron이 Bearer로 보냄)
CRON_SECRET=
